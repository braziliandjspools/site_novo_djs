# === Credenciais FTP (mesmas do portal VIP_FTP_*) ===
FTP_USER=brsvip
FTP_PASSWORD=troque-esta-senha-forte
FTP_PORT=21
# IP público ou domínio do VPS (obrigatório para modo passivo / FileZilla)
FTP_PASV_ADDRESS=SEU_IP_OU_DOMINIO
FTP_PASV_MIN=21100
FTP_PASV_MAX=21110

# === Espelho Google Drive (rclone) ===
# ID da pasta VIP (mesmo GOOGLE_DRIVE_VIP_MUSIC_FOLDER_ID do site)
DRIVE_FOLDER_ID=1zg5As-CxI6qtiAhQM-mOoHseKRxcDXxH
# Intervalo entre syncs, em segundos (padrão: 1h)
SYNC_INTERVAL_SECONDS=3600
# Remote rclone (deve existir em rclone/rclone.conf)
RCLONE_REMOTE=gdrive
