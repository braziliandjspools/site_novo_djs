# Copie para rclone.conf e ajuste o caminho do JSON:
#   cp rclone.conf.example rclone.conf
#
# 1) Crie uma service account no Google Cloud (IAM)
# 2) Ative Google Drive API
# 3) Baixe o JSON da chave → salve como rclone/service-account.json
# 4) Compartilhe a pasta VIP do Drive com o e-mail da service account (Editor ou Leitor)

[gdrive]
type = drive
scope = drive.readonly
service_account_file = /config/rclone/service-account.json
# Impede o rclone de pedir team drive; pasta compartilhada via "Shared with me"
# root_folder_id é opcional — o sync.sh usa DRIVE_FOLDER_ID na URL
acknowledge_abuse = true
