generator client {
  provider      = "prisma-client-js"
  // native = Windows/dev; rhel = runtime Vercel (evita embutir engines extras)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PortalPlan {
  NONE
  VIP
  DEEMIX
  ALLAVSOFT
}

model PortalUser {
  id                             Int        @id @default(autoincrement())
  name                           String
  email                          String     @unique
  passwordHash                   String     @map("password_hash")
  whatsapp                       String
  plan                           PortalPlan
  servicePoolsVip                Boolean    @default(false) @map("service_pools_vip")
  serviceDeemix                  Boolean    @default(false) @map("service_deemix")
  serviceAllavsoft               Boolean    @default(false) @map("service_allavsoft")
  /** Valor cobrado do Pools VIP (independente dos outros serviços). */
  servicePoolsVipValue           Decimal    @default(0) @map("service_pools_vip_value") @db.Decimal(10, 2)
  servicePoolsVipDueAt           DateTime?  @map("service_pools_vip_due_at")
  /** Valor cobrado do Deemix. */
  serviceDeemixValue             Decimal    @default(0) @map("service_deemix_value") @db.Decimal(10, 2)
  serviceDeemixDueAt             DateTime?  @map("service_deemix_due_at")
  /** Valor cobrado do Allavsoft (licença vitalícia: due_at nulo). */
  serviceAllavsoftValue          Decimal    @default(0) @map("service_allavsoft_value") @db.Decimal(10, 2)
  serviceAllavsoftDueAt          DateTime?  @map("service_allavsoft_due_at")
  /** Soma dos valores dos serviços ativos (compat / resumo). */
  monthlyValue                   Decimal    @default(0) @map("monthly_value") @db.Decimal(10, 2)
  /** Próximo vencimento agregado (menor due de VIP/Deemix ativos). */
  nextDueAt                      DateTime   @map("next_due_at")
  active                         Boolean    @default(true)
  musicProducerDeliveriesEnabled Boolean    @default(false) @map("music_producer_deliveries_enabled")
  createdAt                      DateTime   @default(now()) @map("created_at")
  updatedAt                      DateTime   @updatedAt @map("updated_at")

  deliveries                 MusicProducerDelivery[]
  briefings                  MusicProducerBriefing[]
  downloadDevices            DownloadDevice[]
  downloadJobs               DownloadJob[]
  siteNotices                SiteNotice[]
  noticeReceipts             SiteNoticeReceipt[]
  hotmartSubscriptions       HotmartSubscription[]
  mercadoPagoOrders          MercadoPagoOrder[]
  generatedSongs             GeneratedSong[]
  musicGenerationUsages      MusicGenerationUsage[]
  allavsoftLicenseAssignments AllavsoftLicenseAssignment[]

  @@index([nextDueAt])
  @@index([servicePoolsVipDueAt])
  @@index([serviceDeemixDueAt])
  @@map("portal_users")
}

/** Pool de seriais Allavsoft (um serial = uma atribuição no máximo). */
model AllavsoftKeyPool {
  id         String                      @id @default(cuid())
  serial     String                      @unique
  createdAt  DateTime                    @default(now()) @map("created_at")
  assignment AllavsoftLicenseAssignment?

  @@map("allavsoft_key_pool")
}

/** Serial atribuído a um usuário do portal; copiedAt marca consumo (uso único). */
model AllavsoftLicenseAssignment {
  id           String           @id @default(cuid())
  portalUserId Int              @map("portal_user_id")
  portalUser   PortalUser       @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  keyId        String           @unique @map("key_id")
  key          AllavsoftKeyPool @relation(fields: [keyId], references: [id], onDelete: Restrict)
  licenseName  String           @map("license_name")
  issuedAt     DateTime         @default(now()) @map("issued_at")
  copiedAt     DateTime?        @map("copied_at")

  @@index([portalUserId, issuedAt])
  @@map("allavsoft_license_assignments")
}

enum HotmartSubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  REFUNDED
  CHARGEBACK
  PAST_DUE
}

/** Assinatura/compra Hotmart vinculada ao usuário do portal (acesso BRS). */
model HotmartSubscription {
  id                       String                    @id @default(cuid())
  portalUserId             Int                       @map("portal_user_id")
  portalUser               PortalUser                @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  planId                   String                    @map("plan_id")
  status                   HotmartSubscriptionStatus @default(ACTIVE)
  provider                 String                    @default("hotmart")
  providerCustomerId       String?                   @map("provider_customer_id")
  providerSubscriptionId   String?                   @map("provider_subscription_id")
  providerProductId        String?                   @map("provider_product_id")
  providerOfferId          String?                   @map("provider_offer_id")
  providerTransactionId    String?                   @map("provider_transaction_id")
  startedAt                DateTime?                 @map("started_at")
  currentPeriodEnd         DateTime?                 @map("current_period_end")
  canceledAt               DateTime?                 @map("canceled_at")
  refundedAt               DateTime?                 @map("refunded_at")
  lastPaymentAt            DateTime?                 @map("last_payment_at")
  accessRevokedAt          DateTime?                 @map("access_revoked_at")
  activationEmailSentAt    DateTime?                 @map("activation_email_sent_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  @@unique([providerSubscriptionId])
  @@index([portalUserId, status])
  @@index([providerTransactionId])
  @@map("hotmart_subscriptions")
}

/** Eventos de webhook já processados (idempotência). */
model HotmartWebhookEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique @map("event_id")
  event         String
  transactionId String?  @map("transaction_id")
  result        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([transactionId])
  @@map("hotmart_webhook_events")
}

/** Compra aprovada sem usuário BRS — associada no cadastro pelo e-mail. */
model HotmartPendingPurchase {
  id                     String    @id @default(cuid())
  email                  String
  buyerName              String?   @map("buyer_name")
  planId                 String    @map("plan_id")
  providerTransactionId  String    @unique @map("provider_transaction_id")
  providerSubscriptionId String?   @map("provider_subscription_id")
  providerProductId      String?   @map("provider_product_id")
  providerOfferId        String?   @map("provider_offer_id")
  currentPeriodEnd       DateTime? @map("current_period_end")
  claimedAt              DateTime? @map("claimed_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@index([email, claimedAt])
  @@map("hotmart_pending_purchases")
}

enum MercadoPagoOrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

/**
 * Pedido único Mercado Pago (Checkout Pro).
 * Nunca armazena cartão, CVV, token de cartão ou Access Token.
 */
model MercadoPagoOrder {
  id                      String                 @id @default(uuid()) @db.Uuid
  portalUserId            Int                    @map("portal_user_id")
  portalUser              PortalUser             @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  planId                  String                 @map("plan_id")
  amount                  Decimal                @db.Decimal(10, 2)
  currency                String                 @default("BRL")
  status                  MercadoPagoOrderStatus @default(PENDING)
  provider                String                 @default("mercadopago")
  /** Identifica o pedido interno BRS (enviado ao MP como external_reference). */
  externalReference       String                 @unique @map("external_reference")
  mercadoPagoPreferenceId String?                @map("mercado_pago_preference_id")
  /** Único quando preenchido (Postgres permite vários NULL). */
  mercadoPagoPaymentId    String?                @unique @map("mercado_pago_payment_id")
  payerEmail              String?                @map("payer_email")
  rawStatus               String?                @map("raw_status")
  approvedAt              DateTime?              @map("approved_at")
  activationEmailSentAt   DateTime?              @map("activation_email_sent_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  @@index([portalUserId, status])
  @@index([mercadoPagoPreferenceId])
  @@map("mercado_pago_orders")
}

enum SiteNoticeAudience {
  GLOBAL
  USER
}

enum SiteNoticeSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

/** Avisos do admin: globais (todos) ou direcionados a um usuário. */
model SiteNotice {
  id           Int                @id @default(autoincrement())
  title        String
  body         String
  severity     SiteNoticeSeverity @default(INFO)
  audience     SiteNoticeAudience @default(GLOBAL)
  portalUserId Int?               @map("portal_user_id")
  portalUser   PortalUser?        @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  active       Boolean            @default(true)
  startsAt     DateTime?          @map("starts_at")
  endsAt       DateTime?          @map("ends_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  receipts SiteNoticeReceipt[]

  @@index([audience, active, createdAt])
  @@index([portalUserId, active])
  @@map("site_notices")
}

model SiteNoticeReceipt {
  id           Int       @id @default(autoincrement())
  noticeId     Int       @map("notice_id")
  notice       SiteNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  portalUserId Int       @map("portal_user_id")
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  readAt       DateTime? @map("read_at")
  dismissedAt  DateTime? @map("dismissed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([noticeId, portalUserId])
  @@index([portalUserId])
  @@map("site_notice_receipts")
}

enum DownloadJobProvider {
  GOOGLE_DRIVE
}

enum DownloadJobStatus {
  PENDING
  RECEIVED
  DOWNLOADING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model DownloadDevice {
  id           Int        @id @default(autoincrement())
  portalUserId Int        @map("portal_user_id")
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  deviceId     String     @map("device_id")
  deviceName   String     @map("device_name")
  platform     String
  appVersion   String     @map("app_version")
  lastSeenAt   DateTime?  @map("last_seen_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  jobs DownloadJob[]

  @@unique([portalUserId, deviceId])
  @@index([portalUserId])
  @@index([lastSeenAt])
  @@map("download_devices")
}

model DownloadJob {
  id               Int                 @id @default(autoincrement())
  portalUserId     Int                 @map("portal_user_id")
  portalUser       PortalUser          @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  downloadDeviceId Int?                @map("download_device_id")
  downloadDevice   DownloadDevice?     @relation(fields: [downloadDeviceId], references: [id], onDelete: SetNull)
  provider         DownloadJobProvider @default(GOOGLE_DRIVE)
  fileId           String              @map("file_id")
  fileName         String              @map("file_name")
  relativePath     String?             @map("relative_path")
  targetDeviceId   String?             @map("target_device_id")
  fileSize         BigInt?             @map("file_size")
  mimeType         String?             @map("mime_type")
  status           DownloadJobStatus   @default(PENDING)
  progress         Int                 @default(0)
  downloadedBytes  BigInt              @default(0) @map("downloaded_bytes")
  totalBytes       BigInt?             @map("total_bytes")
  error            String?
  claimedAt        DateTime?           @map("claimed_at")
  startedAt        DateTime?           @map("started_at")
  completedAt      DateTime?           @map("completed_at")
  dismissedAt      DateTime?           @map("dismissed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([portalUserId, status])
  @@index([downloadDeviceId, status])
  @@index([status, createdAt])
  @@index([portalUserId, createdAt])
  @@index([portalUserId, fileId])
  @@index([portalUserId, dismissedAt])
  @@map("download_jobs")
}

enum MusicProducerRedoReason {
  AI
  PRODUCER
  BOTH
}

enum MusicProducerBriefingStatus {
  PENDENTE
  EM_REVISAO
  EM_PRODUCAO
  EM_EDICAO
  CONCLUIDO
  EXCLUIDO
}

model MusicProducerDelivery {
  id              Int                      @id @default(autoincrement())
  portalUserId    Int                      @map("portal_user_id")
  portalUser      PortalUser               @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  title           String
  servicePlan     String?                  @map("service_plan")
  chargedAmount   String?                  @map("charged_amount")
  orderDate       DateTime                 @map("order_date")
  releasedAt      DateTime?                @map("released_at")
  downloadUrl     String                   @map("download_url")
  notes           String?
  visible         Boolean                  @default(false)
  clientRating    Int?                     @map("client_rating")
  clientReview    String?                  @map("client_review")
  redoRequested   Boolean                  @default(false) @map("redo_requested")
  redoReason      MusicProducerRedoReason? @map("redo_reason")
  redoNotes       String?                  @map("redo_notes")
  redoRequestedAt DateTime?                @map("redo_requested_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@index([portalUserId, orderDate])
  @@map("music_producer_deliveries")
}

model MusicProducerBriefing {
  id                Int                         @id @default(autoincrement())
  portalUserId      Int?                        @map("portal_user_id")
  portalUser        PortalUser?                 @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  name              String
  email             String
  whatsapp          String
  servicePlan       String                      @map("service_plan")
  estimatedQuote    String?                     @map("estimated_quote")
  idea              String
  lyrics            String?
  style             String?
  occasion          String?
  deadline          String?
  deadlineSurcharge String?                     @map("deadline_surcharge")
  additionalNotes   String?                     @map("additional_notes")
  status            MusicProducerBriefingStatus @default(PENDENTE)
  adminNote         String?                     @map("admin_note")
  emailSent         Boolean                     @default(false) @map("email_sent")
  emailError        String?                     @map("email_error")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  @@index([portalUserId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("music_producer_briefings")
}

enum GeneratedSongStatus {
  QUEUED
  GENERATING
  COMPLETED
  FAILED
}

/** Música gerada no estúdio BRS Flow (Lyria via OpenRouter). */
model GeneratedSong {
  id               String              @id @default(cuid())
  portalUserId     Int                 @map("portal_user_id")
  portalUser       PortalUser          @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  /** Agrupa versões da mesma “música”. */
  songGroupId      String              @map("song_group_id")
  versionNumber    Int                 @default(1) @map("version_number")
  title            String
  style            String?
  mood             String?
  voice            String?
  language         String?             @default("pt-BR")
  bpm              Int?
  instrumental     Boolean             @default(false)
  prompt           String
  lyrics           String?
  /** Instrução final enviada ao modelo (não expor a key). */
  modelPrompt      String?             @map("model_prompt") @db.Text
  status           GeneratedSongStatus @default(QUEUED)
  errorMessage     String?             @map("error_message")
  provider         String              @default("openrouter")
  model            String
  generationId     String?             @map("generation_id")
  idempotencyKey   String?             @unique @map("idempotency_key")
  audioUrl         String?             @map("audio_url")
  audioStorageKey  String?             @map("audio_storage_key")
  /** Fallback MVP quando R2 não está configurado — nunca expor em listagens. */
  audioBase64      String?             @map("audio_base64") @db.Text
  audioMimeType    String?             @map("audio_mime_type")
  artworkUrl       String?             @map("artwork_url")
  durationSeconds  Float?              @map("duration_seconds")
  favorite         Boolean             @default(false)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  usages MusicGenerationUsage[]

  @@unique([songGroupId, versionNumber])
  @@index([portalUserId, createdAt])
  @@index([portalUserId, favorite])
  @@index([songGroupId])
  @@index([status, createdAt])
  @@map("generated_songs")
}

model MusicGenerationUsage {
  id            String         @id @default(cuid())
  portalUserId  Int            @map("portal_user_id")
  portalUser    PortalUser     @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  songId        String?        @map("song_id")
  song          GeneratedSong? @relation(fields: [songId], references: [id], onDelete: SetNull)
  model         String
  status        String
  estimatedCost Decimal?       @map("estimated_cost") @db.Decimal(10, 4)
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([portalUserId, createdAt])
  @@index([songId])
  @@map("music_generation_usages")
}
