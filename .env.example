# Copie para .env.local e preencha. Nunca commite .env.local.

# Domínio canônico do site (HTTPS obrigatório para back_urls do Checkout Pro)
NEXT_PUBLIC_SITE_URL=https://www.brazilianremixservice.com.br

# Mercado Pago — Checkout Pro (somente servidor; NUNCA use NEXT_PUBLIC_ para secrets)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_MODE=test
# Obrigatório em production (valida collector_id do pagamento)
# MERCADO_PAGO_COLLECTOR_ID=

# Hotmart — somente webhook legado (assinantes existentes)
HOTMART_WEBHOOK_SECRET=
HOTMART_DRIVE_MONTHLY_PRODUCT_ID=
HOTMART_DRIVE_MONTHLY_OFFER_CODE=

# E-mail (Resend) — ativação de acesso
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Downloader — URL pública do instalador (opcional; há fallback no código)
# DOWNLOADER_DOWNLOAD_URL=https://www.brazilianremixservice.com.br/downloads/BRS-Downloader_1.0.6_estable_x64-setup.exe
# DOWNLOADER_LATEST_VERSION=1.0.6_estable
