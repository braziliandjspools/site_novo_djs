# Copie para .env.local e preencha. Nunca commite .env.local.

# Hotmart — webhook (token X-HOTMART-HOTTOK)
HOTMART_WEBHOOK_SECRET=

# Hotmart — BRS Drive Mensal
HOTMART_DRIVE_MONTHLY_CHECKOUT_URL=
HOTMART_DRIVE_MONTHLY_PRODUCT_ID=
HOTMART_DRIVE_MONTHLY_OFFER_CODE=

# Opcional: mesma URL no frontend (sem secrets)
NEXT_PUBLIC_HOTMART_DRIVE_MONTHLY_CHECKOUT_URL=

# Opcional: preço exibido em /plans (fonte única de display)
NEXT_PUBLIC_HOTMART_DRIVE_MONTHLY_PRICE=R$ 50

# E-mail (Resend) — ativação de acesso Hotmart
RESEND_API_KEY=
RESEND_FROM_EMAIL=
